# Nirnay Pay (RecoveryOS) - Root Environment Configuration Template

# Database Credentials
DATABASE_URL=postgresql://postgres:password@localhost:5432/nirnay_pay
SUPABASE_DATABASE_URL=postgresql://postgres:password@localhost:5432/nirnay_pay

# Application Core Configuration
APP_NAME="Nirnay Pay (RecoveryOS)"
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
SECRET_KEY=your_secure_random_secret_key_here

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# AI / Local LLM Configuration (Ollama / Grok API)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GROK_API_KEY=your_xai_grok_api_key_optional
